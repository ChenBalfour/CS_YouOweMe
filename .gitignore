# Credentials: only the empty configuration template may be tracked.
.env*
!.env.example
*.env
env.example
*.key
*.pem
credentials*.json

# Only curated anonymous samples may be published from data/.
data/*
!data/samples/
!data/README.md
data/local/
docs/local/
*.sqlite
*.sqlite3
*.db
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
build/
dist/
*.egg-info/
.coverage
htmlcov/
.DS_Store
Thumbs.db
.idea/
.vscode/

# Full vendor web/document pages are retained locally only.
docs/*.html
